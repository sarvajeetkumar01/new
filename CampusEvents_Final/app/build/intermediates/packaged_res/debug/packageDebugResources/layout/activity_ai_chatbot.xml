<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F8F8">
    <TextView android:id="@+id/backButton" android:layout_width="match_parent" android:layout_height="65dp"
        android:text="Back    Event Assistant" android:textSize="20sp" android:textStyle="bold" android:gravity="center_vertical" android:padding="16dp" android:background="#FFFFFF"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="15dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Hi! I'm your event assistant.&#10;&#10;Ask me about upcoming events, registration, venues, and more."
                android:padding="18dp" android:background="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Try: What events are happening this week?" android:padding="15dp"
                android:background="#111111" android:textColor="#FFFFFF" android:layout_marginTop="15dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:padding="8dp" android:background="#FFFFFF">
        <EditText android:id="@+id/messageInput" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:hint="Type your message..." android:padding="10dp"/>
        <Button android:id="@+id/sendButton" android:layout_width="65dp" android:layout_height="match_parent"
            android:text="Send" android:backgroundTint="#000000" android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
