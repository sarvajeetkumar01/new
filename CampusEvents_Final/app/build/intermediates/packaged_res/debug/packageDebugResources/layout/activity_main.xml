<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="#0F172A">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Campus Events" android:textColor="#FFFFFF" android:textSize="32sp"
        android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Discover • Participate • Grow" android:textColor="#CBD5E1"
        android:textSize="15sp" android:layout_marginTop="8dp"/>
    <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="50dp"/>
</LinearLayout>
